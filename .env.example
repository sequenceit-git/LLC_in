# ==============================================================================
# LLC Publication Online — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Traefik & Domain (VPS Production)
# ------------------------------------------------------------------------------
# Primary domain for your application (e.g. llcpublications.com or your-domain.com)
DOMAIN=llcpublications.com

# Docker network where Traefik is running.
# Common names: traefik_default, traefik-net, traefik-public, web, proxy
TRAEFIK_NETWORK=traefik_default

# Traefik entrypoint names configured in your Traefik setup
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web

# Traefik Let's Encrypt certificate resolver name configured in traefik.yml / static flags
# Common names: letsencrypt, myresolver, le, cloudflare
TRAEFIK_CERTRESOLVER=letsencrypt

# Traefik Host Rule. By default matches both apex and www:
TRAEFIK_HOST_RULE=Host(`llcpublications.com`) || Host(`www.llcpublications.com`)

# ------------------------------------------------------------------------------
# 2. Backend API Configuration (Node.js / Express)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Atlas or self-hosted)
DB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/llc_publication?retryWrites=true&w=majority

# Allowed CORS origins (comma-separated, without trailing slashes)
CORS_ORIGIN=https://llcpublications.com,https://www.llcpublications.com

# JWT Authentication for Admin Panel
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_prod_888
JWT_EXPIRES_IN=7d

# Optional: Allow demo orders seed in production ('1' to allow, leave unset otherwise)
# ALLOW_DEMO_SEED=1

# ------------------------------------------------------------------------------
# 3. Frontend Configuration (Vite / React)
# ------------------------------------------------------------------------------
# Base API URL. Leave empty to use relative '/api' proxy (recommended when both
# frontend and backend are hosted under the same domain behind Traefik).
# Only set this if you host your backend API on a separate subdomain/domain (e.g. https://api.yourdomain.com).
VITE_API_URL=

